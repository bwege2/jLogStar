#!/usr/bin/env bash
# jLogStar launcher: finds Java 21+, enables the Vector API for Lucene, sizes the heap.
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# release layout: jar next to this script; source checkout: target/
JAR="$DIR/jlogstar.jar"
[[ -f "$JAR" ]] || JAR="$DIR/target/jlogstar.jar"
[[ -f "$JAR" ]] || { echo "jlogstar.jar nicht gefunden – im Quellverzeichnis zuerst bauen: mvn package" >&2; exit 1; }
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/java}"
JAVA="${JAVA:-java}"
# heap: 1/3 of RAM, at most 16 GB (override with JLOGSTAR_HEAP=8g)
if [[ -z "${JLOGSTAR_HEAP:-}" ]]; then
  mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 8388608)
  heap_mb=$(( mem_kb / 1024 / 3 )); (( heap_mb > 16384 )) && heap_mb=16384; (( heap_mb < 1024 )) && heap_mb=1024
  JLOGSTAR_HEAP="${heap_mb}m"
fi
exec "$JAVA" -Xmx"$JLOGSTAR_HEAP" -XX:+UseParallelGC --add-modules jdk.incubator.vector --enable-native-access=ALL-UNNAMED \
  -Djava.util.logging.config.file=/dev/null -jar "$JAR" "$@" 2> >(grep -v -E 'incubator|^WARNING: Using' >&2)
